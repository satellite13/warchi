# API Configuration
# VITE_API_PROXY_TARGET=http://localhost:8080
# VITE_API_BASE_URL=
# VITE_API_VERSION=v1

# Model live sync (optional)
# ws      - only WebSocket/STOMP event-triggered pull
# poll    - only periodic pull
# hybrid  - WebSocket primary + polling fallback
# VITE_MODEL_LIVE_SYNC_MODE=hybrid
# VITE_MODEL_LIVE_POLL_MS=15000

# Public marketing site (warchi-site)
# VITE_SITE_URL=http://localhost:5174
# VITE_SITE_RETURN_ORIGINS=http://localhost:5174
