# API Configuration
# Local Vite proxies /api to this target. If it points at k8s
# (e.g. http://arepos-server.arch.svc.cluster.local:8080) and the backend
# sets cookie Domain=.arch.svc.cluster.local, vite.config strips Domain so
# auth cookies work on http://localhost:5173.
# VITE_API_PROXY_TARGET=http://localhost:8080
# VITE_API_BASE_URL=
# VITE_API_VERSION=v1

# Model live sync (optional)
# ws      - only WebSocket/STOMP event-triggered pull
# poll    - only periodic pull
# hybrid  - WebSocket primary + polling fallback
# VITE_MODEL_LIVE_SYNC_MODE=hybrid
# VITE_MODEL_LIVE_POLL_MS=15000

# Public marketing site (warchi-site)
# VITE_SITE_URL=http://localhost:5174
# VITE_SITE_RETURN_ORIGINS=http://localhost:5174
