# API Configuration
# VITE_API_PROXY_TARGET=http://localhost:8080
# VITE_API_BASE_URL=
# VITE_API_VERSION=v1

# Canvas World Settings
# VITE_CANVAS_WORLD_WIDTH=5000
# VITE_CANVAS_WORLD_HEIGHT=3000

# Canvas Zoom Settings
# VITE_CANVAS_ZOOM_MIN=0.25
# VITE_CANVAS_ZOOM_MAX=4
# VITE_CANVAS_ZOOM_SPEED=0.0015

# Canvas Pan Settings
# VITE_CANVAS_PAN_SPEED=1
# VITE_CANVAS_PAN_INERTIA_ENABLED=true
# VITE_CANVAS_PAN_INERTIA_FRICTION=0.0025
# VITE_CANVAS_PAN_INERTIA_MIN_VELOCITY=0.02
# VITE_CANVAS_PAN_INERTIA_BOUNCE=false
# VITE_CANVAS_PAN_INERTIA_BOUNCE_STRENGTH=0

# Canvas Grid Settings
# VITE_CANVAS_GRID_BASE_SPACING=80
# VITE_CANVAS_GRID_MIN_SPACING=32
# VITE_CANVAS_GRID_MAX_SPACING=160
# VITE_CANVAS_GRID_COLOR=rgba(120, 128, 140, 0.25)
# VITE_CANVAS_GRID_BACKGROUND=#f8f9fb

# Canvas Scrollbars Settings
# VITE_CANVAS_SCROLLBARS_THICKNESS=10
# VITE_CANVAS_SCROLLBARS_MARGIN=8
# VITE_CANVAS_SCROLLBARS_MIN_LENGTH=40
# VITE_CANVAS_SCROLLBARS_AUTO_SCROLL_ENABLED=true
# VITE_CANVAS_SCROLLBARS_AUTO_SCROLL_SPEED=1.2
# VITE_CANVAS_SCROLLBARS_DOUBLE_CLICK_CENTER_RATIO=0.5
# VITE_CANVAS_SCROLLBARS_TRACK_COLOR=rgba(20, 24, 28, 0.12)
# VITE_CANVAS_SCROLLBARS_BAR_COLOR=rgba(20, 24, 28, 0.35)
# VITE_CANVAS_SCROLLBARS_TRACK_HOVER_COLOR=rgba(20, 24, 28, 0.18)
# VITE_CANVAS_SCROLLBARS_BAR_HOVER_COLOR=rgba(20, 24, 28, 0.5)
