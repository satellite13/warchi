# Yandex Cloud
YC_CLOUD_ID="b1g..."
YC_FOLDER_ID="b1g..."
YC_ZONE="ru-central1-a"

# Kubernetes
K8S_VERSION="1.32"
NODE_COUNT=2
NODE_CPU=2
NODE_MEMORY=4
NODE_DISK_SIZE=30

# PostgreSQL
PG_VERSION="16"
PG_RESOURCE_PRESET="s2.micro"
PG_DISK_SIZE=10
DB_NAME="arepos"
DB_USER="arepos"
DB_PASSWORD="CHANGE_ME"
# Опционально: пользователь с правами на CREATE EXTENSION для bootstrap-проверки
# Если не задано, будет использован DB_USER.
DB_ADMIN_USER=""
DB_ADMIN_PASSWORD=""

# Object Storage
S3_BUCKET_NAME="arepos-files"

# Namespace
NAMESPACE="arch"

# Публичный hostname фронта (Ingress warchi); WebSocket /ws идёт на тот же host. Пример: app.example.com
# WARCHI_INGRESS_HOST="warchi.ru"
