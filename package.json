{
  "name": "warchi",
  "private": true,
  "version": "0.4.6",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/check-node-version.mjs",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .vue,.ts,.tsx --cache",
    "lint:fix": "eslint src --ext .vue,.ts,.tsx --fix",
    "test:coverage": "vitest run --coverage",
    "test:e2e:seed-user": "node scripts/seed-e2e-user.mjs",
    "test:e2e": "npm run test:e2e:seed-user && npx playwright test",
    "test:e2e:ui": "npm run test:e2e:seed-user && npx playwright test --ui",
    "test:e2e:headed": "npm run test:e2e:seed-user && npx playwright test --headed",
    "test:e2e:slow": "npm run test:e2e:seed-user && npx playwright test --project=slow --headed --workers=1",
    "verify:availability": "bash ./scripts/verify-availability-guard.sh",
    "generate:badge-icon-names": "node scripts/generate-material-icon-names.mjs",
    "copy:badge-icons": "node scripts/copy-material-badge-icons.mjs",
    "prepare:badge-icons": "npm run generate:badge-icon-names && npm run copy:badge-icons"
  },
  "dependencies": {
    "@ckpack/vue-color": "^1.6.0",
    "@fontsource/outfit": "^5.2.8",
    "@ngroznykh/papirus": "^0.5.9",
    "@stomp/stompjs": "^7.3.0",
    "marked": "^17.0.4",
    "md-editor-v3": "^6.4.0",
    "vue": "^3.5.30",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@material-design-icons/svg": "^0.14.15",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "happy-dom": "^20.8.4",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.0.1",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.6"
  }
}
